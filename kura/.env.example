KURA_API_IMAGE=kura-api:local
KURA_BOT_IMAGE=kura-bot:local
KURA_ADMIN_EMAIL=you@example.com
# Generate independently; use URL-safe values for POSTGRES_PASSWORD.
DJANGO_SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-random-password
KURA_BOT_TOKEN=replace-with-a-random-token
KURA_ADMIN_PASSWORD=replace-with-a-long-owner-password
ALLOWED_HOSTS=.tarka.site,localhost,127.0.0.1,api
S3_BUCKET=your-physical-tarka-bucket-name
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-with-bucket-scoped-key
AWS_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
# Local development only. Hosted deployments use http://tarka/v1 automatically.
TARKA_API_KEY=tk_live_replace_me
